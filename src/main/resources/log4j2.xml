<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <KafkaAppender
                name="KafkaAppender"
                topic="custom-logs"
                bootstrapServers="localhost:9092"
        >
            <PatternLayout pattern="%d{dd.MM.yyyy HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </KafkaAppender>
    </Appenders>

    <Loggers>
        <Root level="INFO">
            <AppenderRef ref="KafkaAppender"/>
        </Root>
    </Loggers>
</Configuration>